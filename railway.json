{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "frontend": {
      "source": {
        "directory": "frontend"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm run start",
        "restartPolicy": "ON_FAILURE"
      }
    },
    "backend": {
      "source": {
        "directory": "backend"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm run start",
        "restartPolicy": "ON_FAILURE"
      }
    }
  }
}